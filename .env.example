# Copy to .env.local for development. Vite exposes only VITE_* variables to the browser,
# so never put secrets here.

# Backend base URL (no trailing slash). Required for production builds; on Vercel set it
# per environment (Production / Preview).
VITE_API_BASE_URL=http://localhost:8000

# Optional error tracking; off when empty.
VITE_SENTRY_DSN=
